DATABASE_URL="file:../data/twg.db"

# https://console.cloud.google.com/apis/credentials — create an OAuth 2.0
# Client ID (type "Web application"). Authorized redirect URI must be
# exactly {APP_ORIGIN}/api/auth/google/callback, e.g.
# http://localhost:3000/api/auth/google/callback for local dev.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# https://www.football-data.org/client/register (free tier)
FOOTBALL_DATA_API_KEY=""

# https://dashboard.api-football.com — free plan serves seasons 2022-2024 ONLY,
# so this backfills historical seasons and cannot run the live one.
API_FOOTBALL_KEY=""

# Deferred past v1. See README — signal-cli-rest-api sidecar.
SIGNAL_API_URL="http://signal-api:8080"
SIGNAL_BOT_NUMBER=""
SIGNAL_GROUP_ID=""

# Public origin the app is reachable at. Used to build the Google OAuth
# redirect URI, so it must exactly match what's registered in Google Cloud
# Console, protocol and port included.
APP_ORIGIN="http://localhost:3000"

# IANA zone governing the January change window and digest schedule
APP_TIMEZONE="Australia/Sydney"

# Cloudflare Zero Trust → Networks → Tunnels → create a tunnel → Cloudflared
# connector → copy the token shown at creation (starts "eyJ..."). Routes the
# public domain to the app container over an outbound-only connection, so
# nothing needs to be port-forwarded.
CLOUDFLARE_TUNNEL_TOKEN=""
